{
  "name": "shoots-planner",
  "account_id": "894fd4210d4d7d5532fafc8af53a6b5c",
  "main": "dist/entry.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoots-planner-preview",
      "database_id": "242c735a-da3e-40d6-87cd-2c6e56a1c742"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "shoots-planner-preview-images"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
